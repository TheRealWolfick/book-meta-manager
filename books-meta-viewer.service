[Unit]
Description=Books Meta Viewer (Obsidian data store and ledgers)
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/books-meta-viewer
ExecStart=/usr/bin/node server.js --vault %h/Documents/Obsidian/books --port 4321 --host 127.0.0.1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
