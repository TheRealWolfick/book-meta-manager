# systemd user unit. Install with scripts/install-service.sh [--vault <folder>], which fills in the settings below
# for this device (vault folder, port, host), this repo's location and this machine's node. The vault folder can
# also be chosen on the app's Settings page (saved in ~/.config/books-meta-viewer/settings.json, which wins).
[Unit]
Description=World Builder (Obsidian worldbuilding data store, ledgers and maps)
After=default.target

[Service]
Type=simple
# service settings: the Obsidian vault folder, and where the app listens
Environment=BOOKS_VAULT=%h/Documents/Obsidian/books
Environment=PORT=4321
Environment=BOOKS_HOST=127.0.0.1
WorkingDirectory=%h/Projects/books-meta-viewer
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
